@model PeerCraft.ViewModels.DiscoverViewModel
@{
    ViewData["Title"] = "Discover Projects";
}

<h1 class="page-header">@ViewData["Title"]</h1>

<div class="row g-4">
    <!-- Left Column: Filters -->
    <div class="col-lg-3">
        <div class="card">
            <div class="card-header">
                Filter by Technology
            </div>
            <div class="card-body">
                <form asp-action="Index" method="get">
                    @for (var i = 0; i < Model.AvailableTechnologies.Count; i++)
                    {
                        <div class="form-check mb-2">
                            <input asp-for="AvailableTechnologies[i].IsSelected" type="checkbox" class="form-check-input" id="tech-@(i)"
                                   name="selectedTechnologies" value="@Model.AvailableTechnologies[i].Id"
                                   checked="@Model.AvailableTechnologies[i].IsSelected" />
                            <label class="form-check-label" for="tech-@(i)">@Model.AvailableTechnologies[i].Name</label>
                        </div>
                    }

                    <hr class="my-3" />

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-icon">
                            <img src="~/images/search.svg" class="icon" alt="Apply" />
                            <span>Apply Filters</span>
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-icon">
                            <img src="~/images/close-circle.svg" class="icon" alt="Clear" />
                            <span>Clear Filters</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Column: Project Results -->
    <div class="col-lg-9">
        @if (Model.Projects.Any())
        {
            <div class="list-group">
                @foreach (var project in Model.Projects)
                {
                    <a asp-controller="Project" asp-action="Details" asp-route-id="@project.Id" class="list-group-item list-group-item-action p-4">
                        <div class="d-flex w-100 justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-1">@project.Title</h5>
                                <p class="mb-1 text-muted">@project.Description</p>
                                <small class="text-muted">by @project.Owner.Username</small>
                            </div>
                            <img src="~/images/arrow-right-circle.svg" class="icon d-none d-sm-block" alt="View Details" />
                        </div>
                        @if (project.ProjectTechnologies.Any())
                        {
                            <div class="mt-3">
                                @foreach (var pt in project.ProjectTechnologies.Take(4))
                                {
                                    <span class="badge border rounded-pill text-bg-light fw-normal me-1">@pt.Technology.Name</span>
                                }
                            </div>
                        }
                    </a>
                }
            </div>
        }
        else
        {
            <div class="text-center p-5 card">
                <p class="lead text-muted">No projects found matching your criteria.</p>
            </div>
        }
    </div>
</div>
