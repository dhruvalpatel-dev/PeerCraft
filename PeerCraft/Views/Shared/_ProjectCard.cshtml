@model PeerCraft.Models.Project
@{
    var totalTasks = Model.Tasks?.Count() ?? 0;
    var completedTasks = Model.Tasks?.Count(t => t.IsCompleted) ?? 0;
    var progress = (totalTasks > 0) ? ((double)completedTasks / totalTasks) * 100 : 0;
}

<div class="col">
    <div class="card h-100 project-card">
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">@Model.Title</h5>
            <p class="card-text text-muted small flex-grow-1">
                @* Truncate description for card view if needed *@
                @(Model.Description.Length > 100 ? Model.Description.Substring(0, 100) + "..." : Model.Description)
            </p>

            <div class="mt-auto">
                <div class="d-flex justify-content-between align-items-center mb-1 small text-muted">
                    <span>Progress</span>
                    <span>@completedTasks of @totalTasks</span>
                </div>
                <div class="progress" style="height: 0.5rem;">
                    <div class="progress-bar" role="progressbar" style="width: @progress.ToString("0")%;" aria-valuenow="@progress"></div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white">
            <div class="d-grid">
                <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">View Details</a>
            </div>
        </div>
    </div>
</div>